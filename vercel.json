{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/:path*",
      "destination": "/api/index.js"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/daily-backup",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/meta-health",
      "schedule": "0 * * * *"
    }
  ]
}
