# Pipeline Comercial Mauad - variaveis de ambiente
#
# Copie para .env (que esta no .gitignore) ou cadastre estes valores na aba
# Environment do servico no EasyPanel. NAO coloque segredos reais neste arquivo:
# ele vai para o Git.
#
# Todas as variaveis sao lidas na inicializacao do processo (server.js:6-8 e
# 727-741). Nenhuma precisa existir em tempo de build.

# =============================================================================
# OBRIGATORIAS
# =============================================================================

# Sem 0.0.0.0 o server.js escuta so no loopback do container (default
# 127.0.0.1 em server.js:7) e o proxy do EasyPanel nao alcanca a aplicacao.
HOST=0.0.0.0
PORT=4173

# Connection string do Neon Postgres - a mesma usada hoje na Vercel.
# Se ficar vazia, o app cai no fallback de arquivo JSON em DATA_DIR.
# Aceita tambem DATABASE_URL ou POSTGRES_PRISMA_URL (server.js:727).
POSTGRES_URL=postgresql://usuario:senha@host.neon.tech/dbname?sslmode=require

# Chave HMAC que assina os cookies de sessao.
# Gere com: openssl rand -base64 48
# Sem ela, server.js:728 usa INITIAL_ADMIN_PASSWORD e depois a string publica
# "local-dev-session-secret". Copie o valor atual da Vercel para nao deslogar
# todos os usuarios no momento da virada.
SESSION_SECRET=

# Dominio publico. Monta os links dos e-mails de definicao de senha
# (server.js:1236). Sem barra no final.
APP_URL=https://seu-dominio.com.br

# =============================================================================
# OPCIONAIS
# =============================================================================

# Senha do usuario admin criado no PRIMEIRO boot com banco vazio.
# Default do codigo: Admin@12345 - troque antes de subir em producao.
INITIAL_ADMIN_PASSWORD=

# Bearer token de GET /api/cron/meta-sync. Se ficar vazio o endpoint responde
# 500 (nao 401), o que costuma confundir na hora de depurar.
CRON_SECRET=

# Diretorio do fallback em arquivo. So tem efeito sem POSTGRES_URL.
DATA_DIR=/app/data

# --- E-mail transacional (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=Pipeline Mauad <onboarding@resend.dev>

# --- OpenAI: /api/knowledge/ask e /api/lev-finance/extract ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Evolution API (WhatsApp) ---
EVO_API_URL=
EVO_API_KEY=
EVO_INSTANCE=

# --- Meta / Facebook Lead Ads ---
# Callback do webhook: https://seu-dominio.com.br/api/webhooks/meta
META_VERIFY_TOKEN=
META_APP_ID=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
META_GRAPH_VERSION=v25.0
META_DEFAULT_ASSIGNED_TO=

# =============================================================================
# NAO DEFINIR NO CONTAINER
# =============================================================================
# VERCEL                          -> desvia o DATA_DIR para /tmp (server.js:8)
# VERCEL_PROJECT_PRODUCTION_URL   -> use APP_URL no lugar
